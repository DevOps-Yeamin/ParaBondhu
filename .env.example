# ParaBondhu Environment Configuration

# Backend
PROJECT_NAME="ParaBondhu"
API_V1_STR="/api/v1"
SECRET_KEY="parabondhu-super-secure-production-secret-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
ALGORITHM="HS256"

# Database: SQLite for instant zero-dependency dev, PostgreSQL for production
DATABASE_URL="sqlite:///./parabondhu.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parabondhu"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Firebase Cloud Messaging (Optional for Web Push Notifications)
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID=""

# Default Location Coordinates (Dhaka Zero Point)
DEFAULT_LATITUDE=23.8103
DEFAULT_LONGITUDE=90.4125
